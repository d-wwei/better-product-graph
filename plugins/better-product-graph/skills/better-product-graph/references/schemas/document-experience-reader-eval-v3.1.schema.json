{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "better-product-graph/document-experience-reader-eval.v3.1",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_only",
    "authority",
    "suite_id",
    "case_id",
    "node_id",
    "attempt_id",
    "instruction_ref",
    "instruction_hash",
    "input_refs",
    "input_hashes",
    "preregistration_checkpoint_ref",
    "candidate_ref",
    "profile_ref",
    "guide_ref",
    "reviewer_resource_ref",
    "output_contract_ref",
    "author_execution_ref",
    "reviewer_execution_ref",
    "reviewer_role",
    "isolated_input_refs",
    "reader_readback",
    "reader_outcome_failures",
    "verbosity_assessment",
    "checklist_assessment",
    "visual_assessment",
    "result",
    "primary_diagnosis",
    "primary_repair_technique",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "document-experience-reader-eval.v3.1"},
    "evaluation_only": {"const": true},
    "authority": {"const": "ADVISORY_ONLY"},
    "suite_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "node_id": {"const": "writing-eval.review"},
    "attempt_id": {"type": "string", "minLength": 1},
    "instruction_ref": {"type": "string", "minLength": 1},
    "instruction_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_hashes": {"type": "object"},
    "preregistration_checkpoint_ref": {"type": "object"},
    "candidate_ref": {"type": "object"},
    "profile_ref": {"type": "object"},
    "guide_ref": {"type": "object"},
    "reviewer_resource_ref": {"type": "object"},
    "output_contract_ref": {"type": "object"},
    "author_execution_ref": {"type": "object"},
    "reviewer_execution_ref": {"type": "object"},
    "reviewer_role": {"const": "writing_standard"},
    "isolated_input_refs": {"type": "array", "minItems": 6, "maxItems": 6},
    "reader_readback": {"type": "object"},
    "reader_outcome_failures": {"type": "array"},
    "verbosity_assessment": {"type": "object"},
    "checklist_assessment": {"type": "object"},
    "visual_assessment": {"type": "object"},
    "result": {"enum": ["PASS", "FINDING"]},
    "primary_diagnosis": {
      "type": ["string", "null"]
    },
    "primary_repair_technique": {
      "type": ["string", "null"]
    },
    "claim_boundary": {
      "const": "AGENT_EVAL_RECORDED_HUMAN_READER_OBSERVATION_NOT_RUN"
    }
  },
  "additionalProperties": false
}
