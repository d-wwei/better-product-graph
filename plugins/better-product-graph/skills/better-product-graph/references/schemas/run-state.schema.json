{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "better-product-graph/run-state.v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "state_version",
    "status",
    "current_node",
    "next_allowed_nodes",
    "artifact_refs",
    "interaction_policy",
    "dispatch_attempts",
    "fanout_plans",
    "consumed_attempts",
    "consumed_wait_triggers",
    "current_candidate_ref",
    "candidate_version",
    "ready_receipts",
    "decision",
    "release_ref",
    "source_signal_id",
    "source_occurrence_id"
  ],
  "properties": {
    "schema_version": {"const": "run-state.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_type": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ACTIVE", "PAUSED", "CLOSED", "WAITING_TRIGGER", "WAITING_EVIDENCE", "ROADMAP_ONLY", "RELEASED", "COMPLETED"]},
    "current_node": {"type": "string", "minLength": 1},
    "interaction_policy": {"enum": ["ALLOW_PM_INTERVIEW", "NO_PM_INTERVIEW"]},
    "next_allowed_nodes": {"type": "array", "items": {"type": "string"}},
    "dispatch_attempts": {"type": "array", "items": {"type": "object"}},
    "fanout_plans": {"type": "array", "items": {"type": "object"}},
    "consumed_attempts": {"type": "array", "items": {"type": "string"}},
    "consumed_wait_triggers": {"type": "array", "items": {"type": "object"}},
    "current_candidate_ref": {"type": ["object", "null"]},
    "candidate_version": {"type": "integer", "minimum": 0},
    "ready_receipts": {"type": "array", "items": {"type": "object"}},
    "decision": {"type": ["object", "null"]},
    "release_ref": {"type": ["object", "null"]},
    "source_signal_id": {"type": ["string", "null"]},
    "source_occurrence_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
