    "bug": {"density": "MINIMAL_ACTIONABLE", "max_lines": 40},
    "internal_review": {"density": "CONCERNS_ONLY"},
    "handoff": {"density": "SOURCE_STATUS_NEXT_ACTION"}
  }
}
